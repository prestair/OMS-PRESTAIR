{
  "name": "oms-dashboard",
  "version": "1.0.0",
  "private": true,
  "main": "electron.cjs",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.prestair.oms",
    "productName": "OMS Prestair",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "public/**/*",
      "electron.cjs",
      "package.json",
      ".env"
    ],
    "asarUnpack": [
      "server/**/*",
      ".env",
      "dist/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/@supabase",
        "to": "app/node_modules/@supabase"
      },
      {
        "from": "node_modules/express",
        "to": "app/node_modules/express"
      },
      {
        "from": "node_modules/cors",
        "to": "app/node_modules/cors"
      },
      {
        "from": "node_modules/bcryptjs",
        "to": "app/node_modules/bcryptjs"
      },
      {
        "from": "node_modules/jsonwebtoken",
        "to": "app/node_modules/jsonwebtoken"
      },
      {
        "from": "node_modules/dotenv",
        "to": "app/node_modules/dotenv"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.8"
  },
  "optionalDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
